{
  "name": "my-lovely-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": "^12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write src/ e2e/ scripts/ \"*.config.ts\" env.d.ts \"tsconfig*.json\" .prettierrc.json",
    "format:check": "prettier --check src/ e2e/ scripts/ \"*.config.ts\" env.d.ts \"tsconfig*.json\" .prettierrc.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "check:docs": "node scripts/check-docs.mjs",
    "prepare": "git config core.hooksPath .githooks || echo Skipping git hooks setup: not a git repository"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@lucide/vue": "^1.41.0",
    "@primeuix/themes": "^1.2.5",
    "jeep-sqlite": "^2.8.0",
    "pinia": "^3.0.4",
    "primelocale": "^2.3.2",
    "primevue": "^4.5.5",
    "sql.js": "1.11.0",
    "tailwindcss-primeui": "^0.6.1",
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^3.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.19.19",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "~10.5.1",
    "happy-dom": "^20.11.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

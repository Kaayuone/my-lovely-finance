# Capacitor native projects (android/, ios/) are committed to git so releases
# are reproducible; per-platform build artifacts are excluded by each project's
# own .gitignore (android/.gitignore, and ios/App/.gitignore once iOS is added).

# Signing keystores must never be committed (the Android template leaves these
# commented out, so guard them here explicitly):
*.keystore
*.jks
android/keystore.properties

# Environment files: secrets never enter the repository (AGENTS.md, Code rules)
.env
.env.*
!.env.example
